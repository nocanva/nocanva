# Local and self-hosted development stays open on loopback by default.
NOCANVA_AUTH_MODE=disabled
NOCANVA_WORKSPACE_ID=default
NOCANVA_APPROVAL_MODE=agent_allowed

# Self-hosted HTTP MCP. Use independent random values.
NOCANVA_APP_TOKEN=replace-with-at-least-24-random-characters
NOCANVA_MCP_TOKEN=replace-with-at-least-24-random-characters

# Hosted Google auth is configured with Worker secrets, never committed values:
# BETTER_AUTH_SECRET, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, NOCANVA_APP_TOKEN
