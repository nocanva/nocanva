{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nocanva-mcp",
  "main": "mcp/worker.ts",
  "compatibility_date": "2026-08-19",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "browser": {
    "binding": "BROWSER"
  },
  "services": [
    {
      "binding": "NOCANVA_APP",
      "service": "nocanva-app"
    }
  ],
  "vars": {
    "NOCANVA_BASE_URL": "https://nocanva-app.sidsaini1196.workers.dev"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
