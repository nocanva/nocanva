{
  "name": "nocanva",
  "version": "0.2.0",
  "description": "Deterministic, agent-native workspace for brand-ready media.",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nocanva/nocanva.git"
  },
  "homepage": "https://github.com/nocanva/nocanva#readme",
  "bugs": {
    "url": "https://github.com/nocanva/nocanva/issues"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "volta": {
    "node": "22.17.0",
    "npm": "10.9.2"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "start:self-host": "node scripts/start-self-host.mjs",
    "test": "npm run build && node --experimental-strip-types --test tests/*.test.mjs",
    "render:sample": "node scripts/render-post.mjs",
    "render:nocanva": "node scripts/generate-nocanva-posts.mjs",
    "render:campaigns": "node scripts/generate-brand-campaigns.mjs",
    "mcp:dev": "tsx mcp/server.ts",
    "mcp:http": "tsx mcp/http-server.ts",
    "mcp:fixture": "node scripts/test-mcp-fixture.mjs",
    "mcp:draft-fixture": "node scripts/test-draft-lifecycle.mjs",
    "mcp:http-fixture": "node scripts/test-http-mcp.mjs",
    "self-host": "node scripts/self-host.mjs",
    "self-host:token": "node scripts/show-self-host-token.mjs",
    "seed": "node scripts/seed.mjs",
    "backup": "node scripts/backup.mjs",
    "restore": "node scripts/restore.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "drizzle-orm": "0.45.2",
    "html-to-image": "1.11.13",
    "next": "16.3.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260702.1",
    "@modelcontextprotocol/client": "^2.0.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "playwright": "1.62.1",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.12",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
