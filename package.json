{
  "name": "nocanva",
  "version": "0.4.0-rc.1",
  "description": "Deterministic, agent-native workspace for brand-ready media.",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nocanva/nocanva.git"
  },
  "homepage": "https://github.com/nocanva/nocanva#readme",
  "bugs": {
    "url": "https://github.com/nocanva/nocanva/issues"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "volta": {
    "node": "22.18.0",
    "npm": "10.9.2"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:cloudflare": "NOCANVA_DEPLOY_TARGET=cloudflare WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "deploy:cloudflare": "NOCANVA_DEPLOY_TARGET=cloudflare WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext deploy",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "start:self-host": "node scripts/start-self-host.mjs",
    "test": "npm run build && node --experimental-strip-types --test tests/*.test.mjs",
    "render:sample": "node scripts/render-post.mjs",
    "render:nocanva": "node scripts/generate-nocanva-posts.mjs",
    "render:campaigns": "node scripts/generate-brand-campaigns.mjs",
    "render:beta-samples": "node scripts/generate-beta-samples.mjs",
    "benchmark:blindspot": "node scripts/evaluate-blindspot-benchmark.mjs",
    "benchmark:blindspot:run": "node scripts/run-blindspot-benchmark.mjs",
    "mcp:dev": "tsx mcp/stdio.ts",
    "mcp:http": "tsx mcp/http-server.ts",
    "mcp:worker:dev": "wrangler dev --remote --config wrangler.mcp.jsonc",
    "mcp:worker:types": "wrangler types --config wrangler.mcp.jsonc --include-runtime false --env-interface McpWorkerEnv --strict-vars false mcp/worker-env.d.ts",
    "mcp:worker:deploy": "wrangler deploy --config wrangler.mcp.jsonc",
    "mcp:fixture": "node scripts/test-mcp-fixture.mjs",
    "mcp:draft-fixture": "node scripts/test-draft-lifecycle.mjs",
    "mcp:carousel-fixture": "node scripts/test-carousel-lifecycle.mjs",
    "mcp:http-fixture": "node scripts/test-http-mcp.mjs",
    "mcp:hosted-fixture": "node scripts/test-hosted-launch.mjs",
    "connect": "node scripts/connect-agent.mjs",
    "self-host": "node scripts/self-host.mjs",
    "self-host:token": "node scripts/show-self-host-token.mjs",
    "seed": "node scripts/seed.mjs",
    "backup": "node scripts/backup.mjs",
    "restore": "node scripts/restore.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .wrangler --ignore-pattern mcp/worker-env.d.ts",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@better-auth/mcp": "^1.7.1",
    "@better-auth/oauth-provider": "^1.7.1",
    "@cloudflare/playwright": "^1.3.5",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@puckeditor/core": "^0.23.0",
    "agents": "^0.21.0",
    "better-auth": "^1.7.1",
    "drizzle-orm": "0.45.2",
    "fflate": "^0.8.3",
    "html-to-image": "1.11.13",
    "jose": "^6.2.9",
    "next": "16.3.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^5.20260819.1",
    "@modelcontextprotocol/client": "^2.0.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "playwright": "1.62.1",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.12",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "^8.2.1",
    "wrangler": "^4.124.0"
  },
  "type": "module"
}
